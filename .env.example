# =====================================================================
# AI Media Search — backend environment configuration
# Copy this file to `backend/.env` (or export these variables) to
# override any default. Everything has a sensible default.
# =====================================================================

# --- Application ------------------------------------------------------
APP_ENV=development                # development | production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Admin / security ------------------------------------------------
# Empty in development => destructive endpoints are open locally.
# In production a token MUST be set or destructive endpoints fail closed.
ADMIN_TOKEN=
# Explicitly continue with a mismatched embedding model (dev only, loud warning).
ALLOW_MODEL_MISMATCH=false

# --- Storage / uploads ------------------------------------------------
DATA_DIR=data
MAX_UPLOAD_SIZE_GB=10
CHUNK_SIZE_MB=10
MAX_UPLOAD_AGE_HOURS=24
MAX_CONCURRENT_UPLOADS=20

# --- Search limits -----------------------------------------------------
MAX_QUERY_LENGTH=1000
MAX_VIDEO_IDS=100
MAX_MEDIA_TYPES=20
SEARCH_HISTORY_RETENTION_DAYS=30
MAX_SEARCH_HISTORY_ROWS=10000

# --- Indexing ---------------------------------------------------------
FRAME_INTERVAL_SECONDS=2
FINE_FRAME_INTERVAL_SECONDS=0.25
# phash | dhash | embedding | none
DEDUP_METHOD=phash
DEDUP_THRESHOLD=0.02
EMBEDDING_BATCH_SIZE=16          # 0 => auto-tune from available hardware
MAX_CONCURRENT_JOBS=1
JOB_CANCEL_TIMEOUT_SECONDS=30
AUTO_REQUEUE_ON_RESTART=false
FRAME_EXTRACTION_TIMEOUT_SECONDS=3600

# --- Image safety (decompression-bomb / oversized-dimension guard) ------
MAX_IMAGE_DIMENSION=20000
MAX_IMAGE_PIXELS=120000000

# --- Search -----------------------------------------------------------
TOP_K=50
FINAL_RESULTS=5
TEMPORAL_GROUP_WINDOW_SECONDS=5
MAX_RESULTS_PER_EVENT=1
FINE_SEARCH_WINDOW_SECONDS=4
FINE_SEARCH_MAX_EVENTS=5
# hard bounds for fine-search resource protection
FINE_SEARCH_MAX_VIDEOS=3
FINE_SEARCH_MAX_TIMESTAMPS=10
FINE_SEARCH_MAX_FRAMES=300
FINE_SEARCH_MAX_DURATION_SECONDS=120
FINE_SEARCH_CONCURRENCY=2
CONTEXT_FRAMES=5
# context segment: ±half this window around a match defines start/end
CONTEXT_WINDOW_SECONDS=16
# context frame selection: fetch candidates, dedup, pick representatives
CONTEXT_DEDUP=true
CONTEXT_DEDUP_THRESHOLD=0.02
CONTEXT_MAX_FRAMES=5
# optional grounded AI summary of the context (needs GEMINI_API_KEY)
LLM_CONTEXT_SUMMARY=false
# per_video | none  (score normalization before final ranking)
RANKING_NORMALIZATION=per_video

# --- Query understanding (deterministic, no LLM) ----------------------
# Split connector queries ("X near Y") into component queries and fuse their
# candidates. Single-component queries are byte-for-byte identical to the old
# behaviour, so the baseline is preserved.
QUERY_EXPANSION=true
QUERY_EXPANSION_CONNECTORS=near,with,and,wearing,next to,beside,holding,driving,in front of,on a
QUERY_EXPANSION_MIN_WORDS=2
QUERY_EXPANSION_MAX_COMPONENTS=4
FUSION_METHOD=max                       # max | sum
# keep the FULL query dominant during fusion (recall from components,
# precision from the full query)
FUSION_FULL_QUERY_BOOST=0.05
QUERY_EMBEDDING_CACHE_SIZE=256

# --- Deterministic reranking (configurable weighted signals) -----------
RERANK_DETERMINISTIC=true
RERANK_WEIGHT_SEMANTIC=1.0
# bonus when the representative matched the FULL query embedding
RERANK_WEIGHT_FULL_QUERY=0.1
RERANK_WEIGHT_NEIGHBOR=0.1
RERANK_WEIGHT_DIVERSITY=0.05
# safety-net penalty for same-video near-duplicate events (off by default;
# temporal grouping already merges them)
RERANK_WEIGHT_DUPLICATE=0.0

# --- Performance budgets (documented targets, not hard limits) -----------
SEARCH_P50_LATENCY_BUDGET_MS=1000
SEARCH_P95_LATENCY_BUDGET_MS=5000
RERANK_MAX_CANDIDATES=20
LLM_MAX_TOKENS=64

# --- Embedding / vector store -----------------------------------------
# auto: SigLIP when available (falls back to deterministic ONLY outside
#       production); siglip: require the model; deterministic: baseline.
EMBEDDING_BACKEND=auto
SIGLIP_MODEL=google/siglip-base-patch16-224
HF_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_RERANK=false
GEMINI_TIMEOUT_SECONDS=20
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=media_embeddings

# --- FFmpeg -----------------------------------------------------------
# Leave empty to auto-discover (PATH, then the imageio-ffmpeg bundled binary).
FFMPEG_PATH=
FFPROBE_PATH=

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=
