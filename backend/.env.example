# ── AI Media Hub — backend configuration (see docs/OPERATIONS.md) ──────────
# Copy to backend/.env for local development. NEVER commit real values.

# Core
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Data layer — SQLite for local dev only; PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://aimedia:aimedia@localhost:5432/aimedia
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Storage — local disk now; MinIO/S3 later (plan §10)
STORAGE_BACKEND=local
STORAGE_PATH=
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=aimedia
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Vector search (Phases 5–8)
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_PATH=
CHROMA_COLLECTION=media_frames

# ML / indexing — versioned, fail-closed (plan §18, §58)
EMBEDDING_MODEL=google/siglip-base-patch16-224
EMBEDDING_BACKEND=auto             # siglip | auto | deterministic
COARSE_FRAME_INTERVAL=2
FINE_FRAME_INTERVAL=0.5

# Uploads (Phase 4)
MAX_UPLOAD_SIZE_GB=4
UPLOAD_CHUNK_SIZE_MB=8
MAX_UPLOAD_AGE_HOURS=24
MAX_CONCURRENT_UPLOADS=4

# Jobs (Phase 5+)
MAX_CONCURRENT_JOBS=2

# Auth (plan §6)
AUTH_MODE=dev                      # dev | firebase — production requires firebase
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase.json
BOOTSTRAP_ADMIN_EMAIL=             # email that claims the first ADMIN seat

# Optional reranking (never a hard dependency — plan §23)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Limits
MAX_QUERY_LENGTH=500
MAX_PAGE_SIZE=100
