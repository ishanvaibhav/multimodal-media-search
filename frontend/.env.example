# Frontend environment (copy to .env.local to override)
#
# NEXT_PUBLIC_API_BASE is RELATIVE by default (empty). The browser then calls
# its own origin and the Next.js dev server proxies /api/* to the FastAPI
# backend (see rewrites in next.config.mjs). This is the recommended setup for
# the preview environment and local development — no CORS, no cross-host.
#
# Set it to a backend origin ONLY when the backend is directly reachable from
# the browser (e.g. a separately-deployed backend):
#   NEXT_PUBLIC_API_BASE=https://your-backend.example.com
NEXT_PUBLIC_API_BASE=
